<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hayakana.mj.monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/anaconda3/envs/yfenv/bin/python</string>
    <string>/Users/junmori/mj/monitor.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/junmori/mj</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/junmori/mj/logs/launchd.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/junmori/mj/logs/launchd-error.log</string>
</dict>
</plist>
